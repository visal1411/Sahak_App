# ─── Environment ───────────────────────────────────────────────
NODE_ENV=development

# ─── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_USER=sahak
POSTGRES_PASSWORD=sahak_dev_password
POSTGRES_DB=sahak_db
# Port exposed on your host machine (change if 5432 is taken)
POSTGRES_HOST_PORT=5432

# ─── Redis ──────────────────────────────────────────────────────
REDIS_HOST_PORT=6379

# ─── JWT secrets ────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars_CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars_CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# ─── Cookie options ─────────────────────────────────────────────
# Set COOKIE_SECURE=true in production (requires HTTPS)
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ─── URLs ───────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Email (password reset) ─────────────────────────────────────
# Use https://ethereal.email/create to get free dev credentials
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=no-reply@sahak.app

# ─── Payments ───────────────────────────────────────────────────
# Commission rate as decimal. 0.15 = 15% taken by platform.
COMMISSION_RATE=0.15

# ─── Host port overrides (optional) ────────────────────────────
BACKEND_HOST_PORT=4000
FRONTEND_HOST_PORT=3000
