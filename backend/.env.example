# ─── Runtime ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ───────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://sahak:sahak_dev_password@db:5432/sahak_db

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── JWT ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars
# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token lifetime in days
JWT_REFRESH_EXPIRES_DAYS=30

# ─── Cookies ─────────────────────────────────────────────────
# Set to 'true' in production (requires HTTPS)
COOKIE_SECURE=false
# Cookie domain (leave blank for localhost)
COOKIE_DOMAIN=

# ─── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Email (password reset) ────────────────────────────────────
# Use Ethereal in dev: https://ethereal.email/create
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=no-reply@sahak.app

# ─── Payments ─────────────────────────────────────────────────
# Commission rate as a decimal (0.15 = 15%)
COMMISSION_RATE=0.15

# ─── MinIO / S3 (file uploads — added in Phase 4) ─────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=sahak-uploads
MINIO_USE_SSL=false
